# Copy to ~/.pi/agent/env or export before running install.sh.
# The installer persists exported values into ~/.pi/agent/env.
export E_INFRA_API_KEY='sk-your-key-here'
export OLLAMA_API_KEY='ollama'
export WORKFLOWY_API_KEY='wf-your-key-here'
export ZOTERO_API_KEY='zotero-your-key-here'

# Optional: enables Brave Search in web-search.ts. If unset, web search falls
# back to DuckDuckGo scraping.
# export BRAVE_API_KEY='brave-your-key-here'

# Optional Zotero scoping. Leave unset to use every user/group library
# available to the API key.
# export ZOTERO_USER_ID=''
# export ZOTERO_LIBRARY_ID=''
# export ZOTERO_GROUP_ID=''

# Optional Zotero rate-limit/retry tuning. Defaults are usually fine.
# export ZOTERO_CONCURRENCY='4'
# export ZOTERO_MIN_INTERVAL_MS='250'
# export ZOTERO_MAX_RETRIES='5'
# export ZOTERO_BACKOFF_BASE_MS='500'
# export ZOTERO_BACKOFF_MAX_MS='10000'
# export ZOTERO_REQUEST_TIMEOUT_MS='30000'
# export ZOTERO_SEARCH_REQUEST_TIMEOUT_MS='12000'
# export ZOTERO_SEARCH_BUDGET_MS='45000'

# Optional: used only by remote-monitor.ts if that extension is enabled.
# export MONITOR_PORT='8765'
