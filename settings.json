{
  "lastChangelogVersion": "0.79.8",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.5",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": true,
  "theme": "dark",
  "extensions": [
    "+extensions/dev-status.ts",
    "+extensions/web-search.ts",
    "-extensions/stay-in-current-directory.ts",
    "-extensions/remote-monitor.ts",
    "-extensions/approval-gate.ts",
    "+extensions/context-display.ts",
    "+extensions/workflowy.ts",
    "+extensions/zotero.ts",
    "+extensions/update-einfra-models.ts"
  ],
  "packages": [
    {
      "source": "npm:@micuintus/llm-wiki",
      "skills": [
        "+llm-wiki/SKILL.md"
      ]
    },
    {
      "source": "npm:pi-subagents",
      "prompts": [
        "-prompts/parallel-cleanup.md",
        "-prompts/parallel-context-build.md",
        "-prompts/parallel-handoff-plan.md",
        "-prompts/parallel-research.md",
        "-prompts/parallel-review.md",
        "+prompts/gather-context-and-clarify.md",
        "+prompts/review-loop.md"
      ]
    },
    "npm:pi-intercom",
    "npm:pi-continue"
  ],
  "subagents": {
    "agentOverrides": {
      "context-builder": {
        "disabled": true
      },
      "delegate": {
        "disabled": true
      },
      "oracle": {
        "disabled": true
      },
      "planner": {
        "disabled": true
      },
      "reviewer": {
        "disabled": true
      }
    }
  },
  "httpIdleTimeoutMs": 0,
  "retry": {
    "provider": {
      "timeoutMs": 900000,
      "maxRetries": 0
    }
  }
}
